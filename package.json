{
  "name": "minimalistic-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node --import tsx scripts/prerender.tsx",
    "preview": "vite preview",
    "deploy": "npm run test && npm run typecheck && VITE_BASE_PATH=/website/ npm run build && gh-pages -d dist",
    "assets": "node scripts/generate-assets.mjs",
    "analyze": "ANALYZE=true vite build",
    "images": "node scripts/optimize-images.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "gh-pages": "6.1.1",
    "jsdom": "^26.1.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
